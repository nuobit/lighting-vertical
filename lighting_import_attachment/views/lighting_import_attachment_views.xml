<odoo>
    <record id="lighting_import_attachment_view_form" model="ir.ui.view">
        <field name="name">lighting.import.attachment.form</field>
        <field name="model">lighting.import.attachment</field>
        <field name="arch" type="xml">
            <form string="Import Attachment">
                <header>
                    <button
                        name="action_check"
                        string="Check"
                        type="object"
                        class="oe_highlight"
                        states="draft"
                    />
                    <button
                        name="action_import"
                        string="Import"
                        type="object"
                        class="oe_highlight"
                        states="checked"
                    />
                    <button
                        name="action_set_to_draft"
                        string="Set to Draft"
                        type="object"
                        class="btn-secondary"
                        states="checked"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <div
                    class="alert alert-danger alert-link text-center"
                    role="alert"
                    attrs="{'invisible': [('check_error_files', '=', False)]}"
                >
                    The attachments contain errors. Please review them.
                </div>
                <sheet>
                    <field name="check_error_files" invisible="1" />
                    <div class="oe_title">
                        <label for="name" string="Name" />
                        <h1>
                            <field
                                name="name"
                                attrs="{'readonly': [('state', '!=', 'draft')]}"
                            />
                        </h1>
                    </div>
                    <group>
                        <field
                            name="date"
                            attrs="{'readonly': [('state', '!=', 'draft')]}"
                        />
                    </group>
                    <group string="Attachments">
                        <field name="hide_done" states="draft" />
                        <field
                            name="file_ids"
                            nolabel="1"
                            colspan="2"
                            context="{'tree_view_ref':'lighting_import_attachment.lighting_import_attachment_file_view_tree'}"
                            attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('hide_done', '=', True)]}"
                        />
                        <field
                            name="error_file_ids"
                            nolabel="1"
                            colspan="2"
                            context="{'tree_view_ref':'lighting_import_attachment.lighting_import_attachment_file_view_tree'}"
                            attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('hide_done', '=', False)]}"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="lighting_import_attachment_view_tree" model="ir.ui.view">
        <field name="name">lighting.import.attachment.tree</field>
        <field name="model">lighting.import.attachment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="date" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="lighting_import_attachment_action" model="ir.actions.act_window">
        <field name="name">Import Attachment</field>
        <field name="res_model">lighting.import.attachment</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create the first Attachment</p>
        </field>
    </record>
    <menuitem
        id="lighting_import_menu"
        name="Import"
        parent="lighting.lighting_menu"
        sequence="45"
    />
</odoo>
