<odoo>
    <record id="import_security" model="ir.module.category">
        <field name="name">Lighting Import</field>
        <field name="description">Import security</field>
        <field name="sequence">1007</field>
    </record>
    <record id="import_group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="import_security" />
    </record>
    <record id="import_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field
            name="implied_ids"
            eval="[(6, False, [ref('lighting_import_attachment.import_group_user')])]"
        />
        <field name="category_id" ref="import_security" />
    </record>
</odoo>
