<odoo>
    <record id="lighting_import_attachment_file_view_form" model="ir.ui.view">
        <field name="name">import.product.attachment.file.form</field>
        <field name="model">lighting.import.attachment.file</field>
        <field
            name="inherit_id"
            ref="lighting_import_attachment.lighting_import_attachment_file_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group" position="inside">
                <field name="family_ids" widget="many2many_tags" readonly="1" />
                <field name="attachment_type_id" />
                <field
                    name="file_product_ids"
                    nolabel="1"
                    colspan="2"
                    readonly="1"
                    options="{'no_open': True}"
                />
            </xpath>
        </field>
    </record>
    <record id="lighting_import_attachment_file_view_tree" model="ir.ui.view">
        <field name="name">import.product.attachment.file.tree</field>
        <field name="model">lighting.import.attachment.file</field>
        <field
            name="inherit_id"
            ref="lighting_import_attachment.lighting_import_attachment_file_view_tree"
        />
        <field name="arch" type="xml">
            <tree position="inside">
                <button
                    name="action_show_details"
                    type="object"
                    icon="fa-list fa-lg"
                    title="Product Details"
                    attrs="{'invisible': [('message_info', 'not in', ('checked', 'imported'))]}"
                />
            </tree>
        </field>
    </record>
</odoo>
