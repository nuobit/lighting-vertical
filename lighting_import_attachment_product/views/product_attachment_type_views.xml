<odoo>
    <record id="attachment_type_form_view" model="ir.ui.view">
        <field name="name">attachment.type.form</field>
        <field name="model">lighting.attachment.type</field>
        <field name="inherit_id" ref="lighting.attachment_type_form_view" />
        <field name="arch" type="xml">
            <field name="allow_multiple_files" position="after">
                <field
                    name="is_import_file_policy_variable"
                    widget="boolean_toggle"
                    attrs="{'invisible': [('allow_multiple_files', '=', False)]}"
                />
            </field>
        </field>
    </record>
</odoo>
