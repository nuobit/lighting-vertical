<odoo>
    <!-- window action all attachments menu item-->
    <record id="lighting_attachment_action" model="ir.actions.act_window">
        <field name="name">All Attachments</field>
        <field name="res_model">lighting.attachment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- window action product2attachment smart button-->
    <record id="attachment_list_action" model="ir.actions.act_window">
        <field name="name">Attachment</field>
        <field name="res_model">lighting.attachment</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('product_id', '=', active_id)]</field>
        <field name="context">{'default_product_id': active_id}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create the first attachment</p>
        </field>
    </record>

    <!-- ============= views ============= -->
    <record id="attachment_form_view" model="ir.ui.view">
        <field name="name">attachment.form</field>
        <field name="model">lighting.attachment</field>
        <field name="arch" type="xml">
            <form string="Attachment Form">
                <header>
                    <button
                        name="regenerate_preview"
                        string="Regenerate preview"
                        type="object"
                        groups="base.group_no_one"
                    />
                </header>
                <sheet>
                    <field
                        name="image_medium"
                        class="oe_avatar"
                        widget="image"
                        readonly="1"
                    />
                    <field name="image_known" />
                    <group>
                        <field name="type_id" />
                    </group>
                    <group>
                        <field name="datas_location" />
                        <field
                            name="datas_url"
                            widget="url"
                            attrs="{'invisible': [('datas_location', '!=', 'url')],'required': [('datas_location', '=', 'url')]}"
                        />
                        <field
                            name="datas"
                            filename="datas_fname"
                            attrs="{'invisible': [('datas_location', '!=', 'file')],'required': [('datas_location', '=', 'file')]}"
                        />
                        <field
                            name="datas_fname"
                            invisible="1"
                            attrs="{'required': [('datas_location', '=', 'file')]}"
                        />
                    </group>
                    <group>
                        <field name="name" />
                        <field name="lang_id" />
                        <field name="write_date" readonly="1" />
                        <field name="is_default" />
                        <field name="sequence" />
                        <field name="product_id" readonly="1" />
                    </group>
                    <group attrs="{'invisible': [('datas_location', '=', 'url')]}">
                        <field name="public" />
                        <field
                            name="url"
                            widget="url"
                            attrs="{'invisible': [('public', '!=', True)]}"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="attachment_tree_view" model="ir.ui.view">
        <field name="name">attachment.tree</field>
        <field name="model">lighting.attachment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="type_id" />
                <field name="datas_location" />
                <field name="datas_fname" />
                <field name="datas_size" string="Size" />
                <field name="datas_url" />
                <field name="name" />
                <field name="lang_id" />
                <field name="write_date" />
                <field name="is_default" />
                <field name="product_id" readonly="1" />
            </tree>
        </field>
    </record>

    <record id="attachment_kanban_view" model="ir.ui.view">
        <field name="name">attachment.kanban</field>
        <field name="model">lighting.attachment</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban">
                <field name="id" />
                <field name="datas_fname" />
                <field name="type_id" />
                <field name="image_medium" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <t t-if="record.image_medium.raw_value">
                                    <img
                                        t-att-src="kanban_image('lighting.attachment', 'image_medium', record.id.raw_value)"
                                        alt="Product"
                                        class="o_image_64_contain"
                                    />
                                </t>
                            </div>
                            <div class="oe_kanban_details">
                                <field name="datas_location" invisible="1" />
                                <strong>
                                    <field
                                        name="datas_fname"
                                        attrs="{'invisible': [('datas_location', '!=', 'file')]}"
                                    />
                                    <field
                                        name="datas_url"
                                        attrs="{'invisible': [('datas_location', '!=', 'url')]}"
                                    />
                                </strong>
                                <div>
                                    <field name="type_id" />
                                </div>
                                <div>
                                    <field name="lang_id" />
                                </div>
                                <div>
                                    <field name="write_date" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="lighting_attachment_view_search" model="ir.ui.view">
        <field name="name">lighting.attachment.search</field>
        <field name="model">lighting.attachment</field>
        <field name="arch" type="xml">
            <search string="Search Attachments">
                <field
                    name="name"
                    string="Attachment"
                    filter_domain="['|', '|', '|', '|', '|', '|',
                        ('name', 'ilike', self),
                        ('datas_fname', 'ilike', self),
                        ('type_id.name', 'ilike', self),
                        ('type_id.code', 'ilike', self),
                        ('product_id', 'ilike', self),
                        ('product_id.family_ids', 'ilike', self),
                        ('product_id.catalog_ids', 'ilike', self),
                    ]"
                />
                <field name="datas_fname" string="Filename" />
                <field name="type_id" string="Type" />
                <field name="name" string="Description" />
                <field name="product_id" string="Product" />
                <field
                    name="product_id"
                    string="Family"
                    filter_domain="[('product_id.family_ids', 'ilike', self)]"
                />
                <field
                    name="product_id"
                    string="Catalog"
                    filter_domain="[('product_id.catalog_ids', 'ilike', self)]"
                />
                <group expand="1" string="Group By">
                    <filter
                        name="group_by_product"
                        string="Product"
                        context="{'group_by': 'product_id'}"
                    />
                    <filter
                        name="group_by_type"
                        string="Type"
                        context="{'group_by': 'type_id'}"
                    />
                    <filter
                        name="group_by_filename"
                        string="Filename"
                        context="{'group_by': 'datas_fname'}"
                    />
                    <filter
                        name="group_by_write_date"
                        string="Last Updated"
                        context="{'group_by': 'write_date'}"
                    />
                </group>
            </search>
        </field>
    </record>
</odoo>
