<odoo>
    <!-- window action finishtype2family smart button -->
    <record
        id="lighting_product_finish_type_action_family"
        model="ir.actions.act_window"
    >
        <field name="name">Family</field>
        <field name="res_model">lighting.product.family</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create the first Family</p>
        </field>
    </record>

    <!-- window action finishtype2product smart button -->
    <record
        id="lighting_product_finish_type_action_product"
        model="ir.actions.act_window"
    >
        <field name="name">Product</field>
        <field name="res_model">lighting.product</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create the first Product</p>
        </field>
    </record>

    <!-- view finish type -->
    <record id="product_finish_type_form_view" model="ir.ui.view">
        <field name="name">product.finish.type.form</field>
        <field name="model">lighting.product.finish.type</field>
        <field name="arch" type="xml">
            <form string="Product finish Type Form">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            type="object"
                            class="oe_stat_button"
                            icon="fa-filter"
                            name="action_finish_type_families"
                        ><field
                                string="Families"
                                name="family_count"
                                widget="statinfo"
                            />
                        </button>
                        <button
                            type="object"
                            class="oe_stat_button"
                            icon="fa-filter"
                            name="action_finish_type_products"
                        ><field
                                string="Products"
                                name="product_count"
                                widget="statinfo"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre" />
                        </h1>
                    </div>
                    <group>
                        <field name="code" />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
    <record id="product_finish_type_tree_view" model="ir.ui.view">
        <field name="name">product.finish.type.tree</field>
        <field name="model">lighting.product.finish.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="code" />
                <field name="family_count" string="Families" />
                <button
                    name="action_finish_type_families"
                    type="object"
                    string="Families"
                    icon="fa-external-link"
                    attrs="{'invisible': [('family_count', '=', 0)]}"
                />
                <field name="product_count" string="Products" />
                <button
                    name="action_finish_type_products"
                    type="object"
                    string="Products"
                    icon="fa-external-link"
                    attrs="{'invisible': [('product_count', '=', 0)]}"
                />
            </tree>
        </field>
    </record>

    <!-- window action finish type -->
    <record id="product_finish_type_list_action" model="ir.actions.act_window">
        <field name="name">Finish Types</field>
        <field name="res_model">lighting.product.finish.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create the first product finish typ
            </p>
        </field>
    </record>
</odoo>
