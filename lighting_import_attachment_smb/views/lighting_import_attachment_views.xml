<odoo>
    <record id="lighting_import_attachment_view_form" model="ir.ui.view">
        <field name="name">lighting.import.attachment.form</field>
        <field name="model">lighting.import.attachment</field>
        <field
            name="inherit_id"
            ref="lighting_import_attachment.lighting_import_attachment_view_form"
        />
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="button_load_files_from_source"
                    string="Load Files From Source"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': ['|', ('source', '=', False), ('state', 'not in', ('draft', 'loaded'))]}"
                />
            </header>
            <field name="date" position="after">
                <field name="source" attrs="{'readonly': [('state', '!=', 'draft')]}" />
            </field>
        </field>
    </record>
</odoo>
