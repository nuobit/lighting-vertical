<odoo>
    <record id="product_bulk_update_view" model="ir.ui.view">
        <field name="name">product.bulk.update.form</field>
        <field name="model">lighting.product.bulk.update</field>
        <field name="arch" type="xml">
            <form string="Bulk Update">
                <header />
                <sheet>
                    <group col="12">
                        <group col="1" colspan="1">
                            <field name="state_enabled" nolabel="1" />
                        </group>
                        <group col="2" colspan="11">
                            <field
                                name="state"
                                attrs="{'readonly': [('state_enabled', '=', False)]}"
                            />
                        </group>
                    </group>
                    <group col="12">
                        <group col="1" colspan="1">
                            <field name="state_marketing_enabled" nolabel="1" />
                        </group>
                        <group col="2" colspan="11">
                            <field
                                name="state_marketing"
                                attrs="{'readonly': [('state_marketing_enabled', '=', False)]}"
                            />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="apply_and_close_product_bulk_update"
                        string="Apply and Close"
                        type="object"
                        class="oe_highlight"
                        data-hotkey="q"
                    />
                </footer>
            </form>
        </field>
    </record>
    <record id="product_bulk_update_action" model="ir.actions.act_window">
        <field name="name">Product Data Bulk Update</field>
        <field name="res_model">lighting.product.bulk.update</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="product_bulk_update_view" />
        <field name="target">new</field>
    </record>
</odoo>
