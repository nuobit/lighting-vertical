<odoo>
    <record id="paperformat_product_sheet_vanguard" model="report.paperformat">
        <field name="name">Product sheet Vanguard</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">47</field>
        <field name="margin_bottom">27</field>
        <field name="margin_left">9.2</field>
        <field name="margin_right">9.2</field>
        <field name="header_spacing">35</field>
        <field name="header_line" eval="False" />
        <field name="dpi">90</field>
    </record>
    <record id="report_product_vanguard_action" model="ir.actions.report">
        <field name="name">Report Product Vanguard</field>
        <field name="model">lighting.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="paperformat_product_sheet_vanguard" />
        <field
            name="report_name"
        >lighting_reporting_vanguard_product.report_vanguard</field>
        <field name="print_report_name">"Product - %s" % (object.reference, )</field>
    </record>
</odoo>
