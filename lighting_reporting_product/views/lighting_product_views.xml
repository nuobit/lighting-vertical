<odoo>
    <record id="lihgting_product_form_view" model="ir.ui.view">
        <field name="name">product_view_form.inherit.lighting_reporting</field>
        <field name="model">lighting.product</field>
        <field name="inherit_id" ref="lighting.product_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="%(lighting_reporting_product_wizard_action)d"
                    string="Print datasheet"
                    type="action"
                    class="oe_highlight"
                />
            </xpath>
        </field>
    </record>
</odoo>
