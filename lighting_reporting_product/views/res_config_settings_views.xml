<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.lighting</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10" />
        <field name="inherit_id" ref="lighting.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='lighting']" position="inside">
                <div id="reports">
                        <h2>Reports</h2>
                        <div
                        class="row mt16 o_settings_container"
                        name="report_setting_container"
                    >
                            <div class="col-lg-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <label
                                    string="Default Product Template"
                                    for="product_template"
                                />
                                    <div class="text-muted">
                                        Default product template to generate the
                                        technical sheet.
                                    </div>
                                    <field name="product_template" />
                                </div>
                            </div>
                        </div>
                    </div>
            </xpath>
        </field>
    </record>
</odoo>
