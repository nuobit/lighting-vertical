<odoo>
    <record id="lighting_bmecat_config_view_form" model="ir.ui.view">
        <field name="name">lighting.bmecat.config.form</field>
        <field name="model">lighting.bmecat.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="default" widget="boolean_toggle" />
                        <field name="version" />
                        <field name="state_marketing_filter" widget="many2many_tags" />
                    </group>
                    <notebook>
                        <page string="Mappings">
                            <group col="1">
                                <group string="Packing Units">
                                    <field
                                        name="packing_unit_ids"
                                        colspan="2"
                                        nolabel="1"
                                    >
                                        <tree editable="bottom">
                                            <field name="uom_id" />
                                            <field name="packing_unit_id" />
                                        </tree>
                                    </field>
                                </group>
                                <group string="Mime Code">
                                    <field name="mime_code_ids" colspan="2" nolabel="1">
                                        <tree editable="bottom">
                                            <field name="type_id" />
                                            <field name="mime_code_id" />
                                        </tree>
                                    </field>
                                </group>
                                <group string="Logistic Details">
                                    <field
                                        name="logistic_details_ids"
                                        colspan="2"
                                        nolabel="1"
                                    >
                                        <tree editable="bottom">
                                            <field name="sequence" widget="handle" />
                                            <field name="dimension_type_id" />
                                            <field name="uom_id" />
                                            <field name="dimension" />
                                        </tree>
                                    </field>
                                </group>
                            </group>
                        </page>
                        <page string="Technical Details" groups="base.group_no_one">
                            <group>
                                <field name="validate_xml" widget="boolean_toggle" />
                                <field name="generator_info" />
                                <field name="chunk_size" />
                                <field name="cache_clear_limit" />
                                <field name="ecommerce_datasheet_download_url" />
                                <field name="ecommerce_catalog_url" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="lighting_bmecat_config_view_tree" model="ir.ui.view">
        <field name="name">lighting.bmecat.config.tree</field>
        <field name="model">lighting.bmecat.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="version" />
            </tree>
        </field>
    </record>

    <record id="lighting_bmecat_config_action" model="ir.actions.act_window">
        <field name="name">BMEcat</field>
        <field name="res_model">lighting.bmecat.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create the first bmecat
            </p>
        </field>
    </record>

    <menuitem
        id="lighting_bmecat_config_menu"
        name="Configuration"
        parent="lighting_export_bmecat.lighting_bmecat"
        action="lighting_export_bmecat.lighting_bmecat_config_action"
    />
</odoo>
