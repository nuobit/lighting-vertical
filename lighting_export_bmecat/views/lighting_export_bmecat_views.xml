<odoo>
    <record id="lighting_export_bmecat_view_form" model="ir.ui.view">
        <field name="name">lighting.export.bmecat.form</field>
        <field name="model">lighting.export.bmecat</field>
        <field name="arch" type="xml">
            <form string="BMEcat">
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        options="{'clickable': '1'}"
                    />
                    <button
                        name="generate_bmecat_file"
                        type="object"
                        string="Generate BMEcat file"
                        class="btn-primary"
                        form="post"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />
                    <button
                        name="action_download_bmecat_file"
                        type="object"
                        string="Download BMEcat file"
                        class="btn-primary"
                        icon="fa-download"
                        form="post"
                        attrs="{'invisible': ['|', ('attachment_id', '=', False), ('state', '=', 'draft')]}"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <div class="oe_title">
                        <label for="name" string="Name" />
                        <h1>
                            <field
                                name="name"
                                attrs="{'readonly': [('state', '!=', 'draft')]}"
                            />
                        </h1>
                    </div>
                    <group>
                        <field name="company_id" />
                        <field
                            name="bmecat_config_id"
                            attrs="{'readonly': [('state', '!=', 'draft')]}"
                        />
                        <field
                            name="catalog_id"
                            attrs="{'readonly': [('state', '!=', 'draft')]}"
                        />
                        <field
                            name="language_id"
                            attrs="{'readonly': [('state', '!=', 'draft')]}"
                        />
                        <field
                            name="valid_start_date"
                            attrs="{'readonly': [('state', '!=', 'draft')]}"
                        />
                        <field
                            name="catalog_version"
                            placeholder="000.000"
                            attrs="{'readonly': [('state', '!=', 'draft')]}"
                        />
                        <field name="lang_iso392_2" invisible="1" />
                        <field
                            name="attachment_id"
                            readonly="1"
                            attrs="{'invisible': ['|', ('state', '=', 'draft'), ('attachment_id', '=', False)]}"
                            options="{'no_open': True}"
                        />
                        <field
                            name="create_job"
                            widget="boolean_toggle"
                            attrs="{'readonly': [('state', '!=', 'draft')]}"
                        />
                    </group>
                    <group
                        string="Queue Jobs"
                        attrs="{'invisible': [('create_job', '=', False)]}"
                    >
                        <field
                            name="bmecat_jobs_ids"
                            nolabel="1"
                            colspan="2"
                            readonly="1"
                            context="{'tree_view_ref': 'lighting_export_bmecat.queue_job_view_tree'}"
                        />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="lighting_export_bmecat_view_tree" model="ir.ui.view">
        <field name="name">lighting.export.bmecat.tree</field>
        <field name="model">lighting.export.bmecat</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="valid_start_date" />
                <field name="bmecat_config_id" />
                <field name="catalog_id" />
                <field name="language_id" />
                <field
                    name="state"
                    widget="badge"
                    decoration-muted="state == 'draft'"
                    decoration-primary="state == 'generated'"
                    decoration-warning="state == 'validated'"
                    decoration-success="state == 'published'"
                />
            </tree>
        </field>
    </record>

    <record id="lighting_export_bmecat_view_search" model="ir.ui.view">
        <field name="name">lighting.export.bmecat.search</field>
        <field name="model">lighting.export.bmecat</field>
        <field name="arch" type="xml">
            <search>
                <filter
                    string="Published"
                    name="filter_state_published"
                    domain="[('state', '=', 'published')]"
                />
            </search>
        </field>
    </record>

    <record id="lighting_export_bmecat_action" model="ir.actions.act_window">
        <field name="name">BMEcat Catalogs</field>
        <field name="res_model">lighting.export.bmecat</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_state_published': 1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create the first bmecat</p>
        </field>
    </record>

    <menuitem
        id="lighting_bmecat"
        name="BMEcat"
        parent="lighting.lighting_menu"
        sequence="60"
    >
        <menuitem
            id="lighting_export_bmecat"
            name="Catalogs"
            action="lighting_export_bmecat_action"
        />
    </menuitem>
</odoo>
